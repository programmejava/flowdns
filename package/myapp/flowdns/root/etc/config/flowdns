config flowdns 'main'
	option enabled '0'
	option mode 'socks'
	option provider 'passwall'
	option domestic_dns 'alidns'
	option overseas_dns 'cloudflare'
	option transport 'https'
	list networks 'lan'
	option proxy_port '1080'
	option udp '1'
	option quic_policy 'auto'
	option log_level 'info'
	option dns_failover '1'
	option health_interval '60'
	option auto_update '0'
	option update_days '7'
	# Optional domain suffixes. Each entry also includes all subdomains.
	# list direct_domains 'example.cn'
	# list proxy_domains 'example.com'
	# list realip_domains 'incompatible-application.example'
